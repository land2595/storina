# ===================== Credenziali API OVH =====================
# Crea l'applicazione su https://eu.api.ovh.com/createApp/
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
# Generata con: docker compose run --rm ovh-ks-sniper python create_consumer_key.py
OVH_CONSUMER_KEY=
# Filiale dell'account (determina listino, valuta e IVA)
OVH_SUBSIDIARY=IT

# ===================== Cosa ordinare =====================
# planCode separati da virgola. 24skstor01-v1 = KS-STOR.
# (24skstor012-v1 NON esiste oggi né nel catalogo IT né nelle availabilities: aggiungilo solo se compare)
PLAN_CODES=24skstor01-v1
# Datacenter in ordine di preferenza (bhs = Canada, ordinato con region=canada)
DATACENTERS=gra,rbx,sbg,fra,lon,waw
# Template OS installato alla consegna (none_64.en = nessun OS)
OS_TEMPLATE=none_64.en

# ===================== Requisiti vincolanti =====================
# Storage totale minimo (somma dei dischi, TB decimali, da specifiche del catalogo)
MIN_STORAGE_TB=16
# Canone mensile ricorrente massimo, EUR IVA inclusa
MAX_MONTHLY_PRICE=30
# Primo pagamento massimo (canone + setup), EUR IVA inclusa, letto dall'anteprima checkout
MAX_FIRST_PAYMENT=60

# ===================== Comportamento =====================
# Secondi tra due controlli (minimo forzato: 20)
POLL_INTERVAL=30
# true = fa tutto tranne il checkout finale. Metti false SOLO dopo aver verificato il dry-run.
DRY_RUN=true
# Sospende il monitoraggio senza fermare il container
PAUSED=false
# Rinuncia al diritto di recesso: necessario per la consegna immediata
WAIVE_RETRACTATION=true
# In dry-run, non ripetere la simulazione per la stessa offerta prima di N secondi
DRY_RUN_COOLDOWN=3600
# Errori tecnici consecutivi nella preparazione del carrello prima di fermarsi
MAX_PREP_FAILURES=3

# ===================== Notifiche Telegram (opzionali) =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Messaggio "sono vivo" una volta al giorno all'ora indicata
HEARTBEAT=true
HEARTBEAT_HOUR=9

# ===================== Web UI =====================
# Tutto ciò che sta in questo file si può impostare anche dalla web UI (http://IP-UNRAID:8765):
# i valori salvati lì hanno la precedenza e restano in /data/config.json.
# Password della web UI. Se vuota, la scegli al primo accesso.
WEB_PASSWORD=
WEB_PORT=8765

# ===================== Sistema =====================
TZ=Europe/Rome
